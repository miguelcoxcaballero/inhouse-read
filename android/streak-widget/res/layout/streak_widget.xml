<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de la racha de lectura (StreakWidgetProvider). Los textos de aquí
     son la vista previa del selector de widgets; el proveedor los reemplaza. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/streak_widget_bg"
    android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/streak_flame" android:layout_width="40dp" android:layout_height="48dp"
            android:src="@drawable/streak_flame_lit" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/streak_count_lit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textSize="30sp" android:textColor="@color/streak_widget_orange"
                android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
            <TextView android:id="@+id/streak_count_idle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textSize="30sp" android:textColor="@color/streak_widget_muted"
                android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:visibility="gone" />
            <TextView android:id="@+id/streak_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="días de racha" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/streak_widget_text" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/streak_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Hoy ya has leído" android:textSize="12sp"
        android:textColor="@color/streak_widget_muted" android:maxLines="1" android:ellipsize="end" />

    <ProgressBar android:id="@+id/streak_progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
        android:max="300" android:progress="140" android:indeterminate="false"
        android:progressDrawable="@drawable/streak_widget_progress" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="L" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_0" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_done"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="M" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_1" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_done"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="X" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_2" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_done"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="J" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_3" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_done"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="V" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_4" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_today"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="S" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_5" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_future"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/streak_day_label_6" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="D" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/streak_widget_muted"
                    android:includeFontPadding="false" />
                <ImageView android:id="@+id/streak_day_6" android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginTop="4dp" android:src="@drawable/streak_dot_future"
                    android:importantForAccessibility="no" />
            </LinearLayout>
    </LinearLayout>
</LinearLayout>
