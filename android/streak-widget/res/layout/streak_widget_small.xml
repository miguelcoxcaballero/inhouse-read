<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/streak_widget_bg_lit">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <!-- 1 columna: llama, número y, si se quiere, las horas que quedan del libro. -->
    <ImageView android:id="@+id/streak_flame" android:layout_width="34dp" android:layout_height="40dp"
        android:src="@drawable/streak_flame_lit" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/streak_count_lit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textSize="24sp" android:textColor="@color/streak_widget_orange"
                android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
            <TextView android:id="@+id/streak_count_idle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12" android:textSize="24sp" android:textColor="@color/streak_widget_muted"
                android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/streak_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="días" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/streak_widget_text"
        android:maxLines="1" />
    <TextView android:id="@+id/streak_book" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="" android:textSize="10sp" android:gravity="center"
        android:textColor="@color/streak_widget_muted" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
    <ImageView android:id="@+id/streak_logo" android:layout_width="8dp" android:layout_height="13dp"
        android:layout_gravity="top|end" android:layout_marginTop="8dp" android:layout_marginEnd="9dp"
        android:src="@drawable/streak_widget_logo" android:contentDescription="Inhouse Read" />
</FrameLayout>
