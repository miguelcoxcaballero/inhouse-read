{
  "name": "inhouse-read",
  "private": true,
  "version": "1.7.317",
  "type": "module",
  "description": "Inhouse Read - lector de PDF, ePub y MOBI, hermano de Inhouse Notes.",
  "scripts": {
    "build:rust": "node scripts/build-rust-core.mjs && node scripts/build-rust-ui.mjs",
    "predev": "npm run build:rust",
    "dev": "vite",
    "prebuild": "python vendor/inhouse-services-updater/verify.py . && npm run build:rust",
    "build": "vite build && node scripts/restore-legacy-pdf-chunk.mjs && node scripts/generate-offline-shell.mjs",
    "preview": "vite preview",
    "pretest:unit": "npm run build:rust",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:unit:watch": "npm run build:rust"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "foliate-js": "^1.0.1",
    "onnxruntime-web": "^1.30.0",
    "pdfjs-dist": "^6.3.289",
    "three": "0.180.0"
  }
}
